# ruben-term · zsh (managed by the app: your changes go in local.zsh)

# Sources one of your own files, leaving out the block that terminal-setup adds between
# its two marks. With "loadUserRc": false in the config nothing of yours is read at all.
_rt_source_user() {
  [[ -n $RUBEN_TERM_INHERIT && -r $1 ]] || return 0
  if grep -q '^# >>> terminal-setup >>>' "$1" 2>/dev/null; then
    source =(sed '/^# >>> terminal-setup >>>/,/^# <<< terminal-setup <<</d' "$1")
  else
    source "$1"
  fi
}

_rt_source_user "$RUBEN_TERM_USER_ZDOTDIR/.zshenv"
